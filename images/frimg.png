Option Explicit

Dim objWMIService, colOS, objOS, colCPU, objCPU, objNetwork, objFSO, objDrive
Dim osName, osArch, totalMem, freeMem, compName, userName, cpuName, cTotal, cFree, infoMsg

Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")

' 1. Collect OS & Memory Info
Set colOS = objWMIService.ExecQuery("Select * from Win32_OperatingSystem")
For Each objOS in colOS
    osName = objOS.Caption
    osArch = objOS.OSArchitecture
    totalMem = Round(CDbl(objOS.TotalVisibleMemorySize) / 1024 / 1024, 2) & " GB"
    freeMem = Round(CDbl(objOS.FreePhysicalMemory) / 1024 / 1024, 2) & " GB"
Next

' 2. Collect Computer & User Info
Set objNetwork = CreateObject("WScript.Network")
compName = objNetwork.ComputerName
userName = objNetwork.UserName

' 3. Collect CPU Info
Set colCPU = objWMIService.ExecQuery("Select * from Win32_Processor")
For Each objCPU in colCPU
    cpuName = Trim(objCPU.Name)
Next

' 4. Collect C: Drive Info
Set objFSO = CreateObject("Scripting.FileSystemObject")
If objFSO.DriveExists("C:") Then
    Set objDrive = objFSO.GetDrive("C:")
    cTotal = Round(objDrive.TotalSize / 1024 / 1024 / 1024, 2) & " GB"
    cFree = Round(objDrive.FreeSpace / 1024 / 1024 / 1024, 2) & " GB"
Else
    cTotal = "N/A"
    cFree = "N/A"
End If

' 5. Display System Information in English MsgBox
infoMsg = "===============================" & vbCrLf & _
          "     System Status Information" & vbCrLf & _
          "===============================" & vbCrLf & vbCrLf & _
          "• Computer Name : " & compName & vbCrLf & _
          "• User Account  : " & userName & vbCrLf & _
          "• OS Name       : " & osName & " (" & osArch & ")" & vbCrLf & _
          "• Processor     : " & cpuName & vbCrLf & _
          "• Total RAM     : " & totalMem & " (Free: " & freeMem & ")" & vbCrLf & _
          "• Drive C:      : " & cTotal & " (Free: " & cFree & ")"

MsgBox infoMsg, 64, "System Information"

' ==================================================
' PADDING DATA (FILE SIZE EXPANSION)
' ==================================================
